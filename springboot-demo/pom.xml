<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 2.7.18 是支持 Java 8 的最后一个版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>springboot-demo</artifactId>
    <version>1.0.0</version>
    <name>springboot-demo</name>
    <description>最简单的 Spring Boot Web 示例</description>

    <properties>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- 内嵌 Tomcat + Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            数据库访问：JdbcTemplate（不用 JPA，避免引入 ORM 的隐式行为）
            这个 starter 会带进来：
              spring-jdbc  —— JdbcTemplate 本体
              HikariCP     —— Spring Boot 默认的连接池
              spring-tx    —— 事务（本项目暂时没用，但 starter 会带上）
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
            MySQL 驱动。版本由 Spring Boot 父 POM 统一管理（2.7.18 -> 8.0.33），
            所以这里不用写 <version>。
            注意两点：
              1. 坐标是 com.mysql:mysql-connector-j —— 它是老坐标
                 mysql:mysql-connector-java 的新名字，Spring Boot 2.7.x 管的是新坐标
              2. 驱动类名是 com.mysql.cj.jdbc.Driver（多了个 cj）
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Redis：用来存登录验证码。
            starter 会带进来：
              spring-data-redis —— RedisTemplate 抽象
              lettuce-core      —— 默认的 Redis 客户端（Netty 异步、线程安全）
            本项目只用它做「验证码 5 分钟过期」这一件事，但这正是 Redis 最典型的用法：
            它天然支持 TTL，不用自己写定时任务去清理过期数据。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            测试依赖，一站式包含：
              JUnit 5      —— @Test / @BeforeEach / @ParameterizedTest
              AssertJ      —— assertEquals / assertThat 等断言
              Mockito      —— @Mock / @MockBean 模拟对象
              MockMvc      —— 不启动真实端口就能测 Controller
              JSONAssert / JsonPath —— 断言 JSON 内容
            scope=test 表示只在测试期使用，不会打进最终 jar
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                JaCoCo 代码覆盖率统计。
                执行 mvn test 后会自动生成 HTML 报告：
                    target/site/jacoco/index.html
                报告里能看到每个类、每一行的覆盖情况，以及哪些分支没被走到。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.8</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
